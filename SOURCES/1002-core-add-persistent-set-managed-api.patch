@@ -2796,17 +2798,18 @@ do_devices_delete(const NMCCommand *cmd, NmCli *nmc, int argc, const char *const
 static void
 do_device_set(const NMCCommand *cmd, NmCli *nmc, int argc, const char *const *argv)
