From e933dfaf724a241fef39e9ab6ac358f986dd8288 Mon Sep 17 00:00:00 2001
From: Lubomir Rintel <lkundrak@v3.sk>
Date: Mon, 7 Apr 2025 13:02:50 +0200
Subject: [PATCH 2/8] cloud-setup: factor out creation of new connection

We're going to create connections on wired devices for OCI VM VNICs, and
they're going to also need the same user setting. Factor it out.

(cherry picked from commit 93960639e8d99a8aba7975d4eba172c74b26ecc1)
---
 src/nm-cloud-setup/main.c | 28 +++++++++++++++++++---------
 1 file changed, 19 insertions(+), 9 deletions(-)

diff --git a/src/nm-cloud-setup/main.c b/src/nm-cloud-setup/main.c
index fd2fe4ca95..4070a01e79 100644
--- a/src/nm-cloud-setup/main.c
+++ b/src/nm-cloud-setup/main.c
@@ -691,6 +691,24 @@ try_again:
     return TRUE;
 }
 
+static NMConnection *
+_new_connection(void)
+{
+    NMConnection *connection = NULL;
+    NMSetting    *s_user;
+
+    connection = nm_simple_connection_new();
+
+    s_user = nm_setting_user_new();
